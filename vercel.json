{
  "version": 2,
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "NODE_ENV=production pnpm --filter @workspace/ab-customs-storefront run build",
  "outputDirectory": "artifacts/ab-customs-storefront/dist/public",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}